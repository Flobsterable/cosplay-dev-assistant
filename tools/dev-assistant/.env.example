# Copy to .env and set the key locally. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Required for Docker: absolute path to the application checkout on the Docker host.
PROJECT_PATH=/home/user/projects/my-kmp-app
# Required for running with Node outside Docker. Use an absolute local path.
PROJECT_ROOT=/home/user/projects/my-kmp-app

# Default: local retrieval, scoped reviewers and batched documentation subagents.
LLM_EXECUTION_MODE=economy
# Spend guards per operation, not source truncation.
LLM_MAX_CALLS=24
LLM_MAX_INPUT_CHARACTERS=1000000
# Optional exact-request signed response cache. Use a private directory.
LLM_CACHE_DIR=

# Small tasks: save your own Gemini key locally or as GitHub secret GEMINI_API_KEY.
# Set provider=gemini to require Gemini; missing key fails before any API call.
LLM_SMALL_TASK_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_SMALL_TASK_MAX_INPUT_CHARACTERS=24000
LLM_SMALL_TASK_MAX_OUTPUT_TOKENS=6000
